rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for security
    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'aymane.habbo@gmail.com' ||
        request.auth.token.email == 'aymaneoumlala@gmail.com' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_administrator == true))
      );
    }

    // Users: Profiles, volunteer listeners, and administrators
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // Discussions: Safe anonymous and registered live listening sessions
    match /discussions/{discussionId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Peer listener consultation and handover requests
    match /share_requests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // Support inquiries and contact submissions
    match /support_requests/{requestId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    // The Lounge: Reflective articles and live audio/text rooms
    match /lounge_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Teen Space: Safe resources and articles for adolescents
    match /teen_space_articles/{articleId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Password reset tokens for one-time password recovery links
    match /password_reset_tokens/{tokenId} {
      allow read, write: if true;
    }

    // Default safety fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
